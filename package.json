{
  "name": "viewfinder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "GITHUB_PAGES=true tsc && GITHUB_PAGES=true vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --base /viewfinder/",
    "test": "node --experimental-strip-types --experimental-transform-types src/math.test.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
